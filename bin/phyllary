#!/usr/bin/env bash
# phyllary public launcher: resolve this checkout and hand off to stdlib Python.
set -uo pipefail

phyllary_error() {
	printf 'phyllary: %s\n' "$1" >&2
	if [ "$#" -gt 1 ]; then
		shift
		printf '       %s\n' "$@" >&2
	fi
}

source_path=${BASH_SOURCE[0]}
while [ -L "$source_path" ]; do
	source_dir=${source_path%/*}
	[ "$source_dir" != "$source_path" ] || source_dir=.
	if ! source_dir=$(cd -P -- "$source_dir" 2>/dev/null && pwd); then
		phyllary_error "cannot resolve launcher directory — cd into the Phyllary checkout, then rerun 'phyllary doctor'"
		exit 4
	fi
	if ! target=$(readlink "$source_path" 2>/dev/null); then
		phyllary_error "cannot resolve launcher symlink — cd into the Phyllary checkout, then rerun 'phyllary doctor'"
		exit 4
	fi
	case "$target" in
		/*) source_path=$target ;;
		*) source_path=$source_dir/$target ;;
	esac
done

bin_dir=${source_path%/*}
[ "$bin_dir" != "$source_path" ] || bin_dir=.
if ! bin_dir=$(cd -P -- "$bin_dir" 2>/dev/null && pwd); then
	phyllary_error "cannot resolve launcher directory — cd into the Phyllary checkout, then rerun 'phyllary doctor'"
	exit 4
fi
if ! repo_root=$(cd -P -- "$bin_dir/.." 2>/dev/null && pwd); then
	phyllary_error "cannot resolve Phyllary checkout — cd into the Phyllary checkout, then rerun 'phyllary doctor'"
	exit 4
fi

python_src=$repo_root/src

find_python() {
	local candidate
	for candidate in "${PHYLLARY_PYTHON:-}" python3 python; do
		[ -n "$candidate" ] || continue
		command -v -- "$candidate" >/dev/null 2>&1 || continue
		if "$candidate" - <<'PY' >/dev/null 2>&1
import sys
raise SystemExit(0 if sys.version_info >= (3, 11) else 1)
PY
		then
			printf '%s\n' "$candidate"
			return 0
		fi
	done
	return 1
}

if ! python_bin=$(find_python); then
	phyllary_error "Python 3.11 or newer is required to run Phyllary" \
		"install Python 3.11+ or set PHYLLARY_PYTHON to its path" \
		"then run 'phyllary doctor' if setup is still unclear"
	exit 4
fi

PYTHONDONTWRITEBYTECODE=1 \
PYTHONPATH="$python_src${PYTHONPATH:+:$PYTHONPATH}" \
exec "$python_bin" -m phyllary "$@"
